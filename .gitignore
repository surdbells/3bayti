# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
# Composer's dependency dir for apps/api (PHP). Originally written as
# 'vendor/' and '**/vendor/' which was too broad — it also matched
# apps/mobile/src/app/vendor/ and apps/portal/src/app/vendor/, which
# are SOURCE directories containing real components, not PHP deps.
# Result: those source files were silently excluded from git for
# weeks before Day 6's CI revealed the issue.
# Now scoped to apps/api/vendor/ only.
apps/api/vendor/

# Build artifacts
dist/
**/dist/
build/
**/build/
.angular/
**/.angular/
.turbo/
**/.turbo/
.wrangler/
**/.wrangler/

# Coverage / test
coverage/
**/coverage/
.nyc_output/
**/.phpunit.cache/
**/phpunit-report/

# TS incremental build cache
*.tsbuildinfo
**/*.tsbuildinfo

# Environment & secrets
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

