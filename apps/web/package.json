{
  "name": "@3bayti/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/inject-environment.mjs",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "chromatic": "chromatic --playwright --config-file=chromatic.config.json",
    "serve:ssr:3bayti-web": "node dist/3bayti-web/server/server.mjs",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev": "ng serve",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "echo \"lint not configured yet (M0.4)\""
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@3bayti/api-client": "workspace:*",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.9",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.10.1",
    "@chromatic-com/playwright": "0.10.0",
    "@cloudflare/workers-types": "^4.20260504.1",
    "@playwright/test": "1.50.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "chromatic": "11.20.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.1",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.87.0"
  }
}
