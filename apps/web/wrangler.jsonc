{
  // Cloudflare Pages configuration for the 3bayti storefront (CSR SPA).
  //
  // The storefront is a pure client-side-rendered Angular SPA deployed as
  // static assets to Cloudflare Pages. The only server-side piece is the
  // auth-proxy Pages Function (functions/auth-proxy/[[path]].ts), which
  // Pages auto-detects and deploys alongside the static assets.
  //
  // SPA routing:
  //   The build output has no top-level 404.html, so Cloudflare Pages
  //   treats the deploy as a single-page application and serves
  //   index.html for any unmatched path (its built-in SPA behavior).
  //   Deep links like /product/<slug> resolve to the SPA shell and
  //   Angular routes client-side. No "/* /index.html 200" _redirects
  //   rule is needed — and such a rule triggers an "infinite loop"
  //   build warning, so we deliberately omit it.
  //
  //   _redirects rules never apply to Function routes, so the SPA
  //   fallback never shadows /auth-proxy/*.
  //
  // Reference: https://developers.cloudflare.com/pages/configuration/serving-pages/

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3bayti-web",

  // Angular's browser build output — what Pages serves.
  "pages_build_output_dir": "./dist/3bayti-web/browser",

  // Pinning the compatibility date locks the runtime behavior for the
  // auth-proxy Function. The Function uses only standard Web APIs
  // (fetch/Request/Response/Headers/URL), so nodejs_compat is NOT
  // required. Reference:
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-04-23"
}
