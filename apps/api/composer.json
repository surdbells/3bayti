{
    "name": "3bayti/api",
    "type": "project",
    "description": "3bayti platform backend — Slim 4 + Doctrine 3 + PostgreSQL 16",
    "license": "proprietary",
    "require": {
        "php": "^8.3",

        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",

        "doctrine/orm": "^3.3",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/cache": "^2.2",
        "symfony/cache": "^7.2",

        "firebase/php-jwt": "^7.0",
        "symfony/validator": "^7.2",

        "predis/predis": "^2.3",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.29",

        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.8",
        "ramsey/uuid": "^4.7",
        "symfony/console": "^7.2",

        "guzzlehttp/guzzle": "^7.9",
        "symfony/messenger": "^7.2",
        "symfony/redis-messenger": "^7.2",

        "dompdf/dompdf": "^3.0",
        "zircote/swagger-php": "^4.11",

        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Bayti\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bayti\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "stan": "phpstan analyse src --level=6",
        "lint": "phpcs --standard=PSR12 src/",
        "lint:fix": "phpcbf --standard=PSR12 src/",
        "migrate": "doctrine-migrations migrate --no-interaction",
        "migrate:diff": "doctrine-migrations diff --no-interaction",
        "openapi:generate": "openapi src -o ../../packages/api-contracts/openapi.yaml --format yaml"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
