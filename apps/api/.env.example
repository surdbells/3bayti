# =============================================================================
# 3bayti API — environment configuration template
# =============================================================================
#
# Copy this file to .env in the same directory and fill in real values:
#
#     cp .env.example .env
#
# DO NOT commit .env. Production values live in DigitalOcean App Platform's
# encrypted secret store; this file documents what's needed and shows safe
# defaults for local development.
#
# Conventions
# -----------
#
#   - Anything blank below MUST be set before the API can boot in prod
#     (e.g. JWT_SECRET, DB_PASSWORD, MESSAGECENTRAL_*).
#
#   - Anything with a default value works as-is for local dev — usually
#     against the docker-compose Postgres + Redis from the repo root.
#
#   - "REQUIRED" comments mark variables the API refuses to start without.
#     "OPTIONAL" comments mark variables with sensible defaults.
#
# Generating secrets
# ------------------
#
# Wherever you see "generate with: php -r ...", run that command on your
# machine to produce a fresh random value. NEVER reuse a value across
# environments (dev secret != staging secret != prod secret).

# =============================================================================
# Application
# =============================================================================

# REQUIRED. 'dev', 'test', or 'prod'. Affects:
#   - error display verbosity (prod: hidden; dev: shown)
#   - cache adapter (prod: file cache; dev: array cache)
#   - OTP provider (prod: MessageCentral; else: in-memory)
#   - many other behaviours that grep APP_ENV in the code
APP_ENV=dev

# OPTIONAL. Tag this build for log correlation + the /v3/health version
# field. CI sets this to the git short-sha during deploy.
APP_VERSION=dev

# OPTIONAL. Public URL where this API is reachable. Used in email
# templates ("click here to verify"), in Cors response headers, and in
# OAuth-style redirects. For local dev, leave the localhost default.
APP_URL=http://localhost:8080
# Public base URL for uploaded files served by Apache's /uploads alias.
# On production: https://api-v3.3bayti.ae/uploads
# On a CF-proxied domain with image transforms: same URL — the front-end
# wraps it with /cdn-cgi/image/... for resizing.
# Fallback (when unset): APP_URL + /uploads
UPLOADS_PUBLIC_URL=http://localhost:8080/uploads

# OPTIONAL. Public URL of the Angular web storefront. Used by the
# Noon payment-return redirect (GET /v3/checkout/return/{ref}) to
# bounce a returning web shopper from this API host over to the web
# app's polling page (/checkout/return?ref=...). The mobile webview
# ignores this and detects the API path directly. Defaults to the
# production storefront if unset.
WEB_APP_URL=https://3bayti.ae

# OPTIONAL. Public base URL of the Angular admin/vendor portal. Used in the
# "your seller account is approved" welcome email's sign-in link. Defaults to
# the production portal (https://app.3bayti.ae) if unset.
VENDOR_PORTAL_URL=https://app.3bayti.ae

# REQUIRED. 32-byte random string used for cookie signing, CSRF tokens,
# and other miscellaneous symmetric crypto.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# =============================================================================
# Database — PostgreSQL 16
# =============================================================================
#
# Local dev: docker-compose Postgres on localhost:5432, user=password
# pre-seeded in docker-compose.yml.
#
# Production: DigitalOcean Managed Postgres in the same region as the
# API. App Platform injects DB_HOST/USERNAME/etc automatically when you
# attach the Postgres component to the service in app.yaml.

DB_DRIVER=pdo_pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=3bayti
DB_USERNAME=3bayti
DB_PASSWORD=dev_password_change_in_prod
DB_CHARSET=utf8

# OPTIONAL. PostgreSQL SSL mode. Local dev uses 'prefer' (try SSL,
# fall back to plaintext); production should be 'require' (refuse if
# SSL not available — DO Managed Postgres requires it).
#
# Values: disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=prefer

# =============================================================================
# Redis (cache, rate-limiting, queue)
# =============================================================================
#
# Local dev: docker-compose Redis on localhost:6379, no auth.
# Production: Upstash Redis (or DO Managed Redis). REDIS_PASSWORD
# required for both.
#
# Used in M1.5+ for: OTP send rate-limiting (sliding window), session
# fingerprinting, idempotency keys.

REDIS_HOST=localhost
REDIS_PORT=6379

# OPTIONAL. Redis ACL password. Empty for local docker-compose;
# required for production.
REDIS_PASSWORD=

# OPTIONAL. Redis DB number (0-15 by default). 0 is fine for our use;
# different services on the same Redis instance might use different DBs.
REDIS_DB=0

# =============================================================================
# JWT (auth tokens — see M1.2 for design)
# =============================================================================

# REQUIRED. HS256 signing key. MUST be at least 32 bytes; we recommend 64
# (~128 hex chars). The api refuses to boot if this is shorter.
# Generate with: php -r "echo bin2hex(random_bytes(64));"
JWT_SECRET=

# OPTIONAL. Access token lifetime in seconds. Per Decision A.6.1 = 900
# (15 minutes). Shorter is more secure but causes more /refresh calls.
JWT_ACCESS_TOKEN_TTL=900

# OPTIONAL. Refresh token lifetime in seconds. Per Decision A.6.1 = 604800
# (7 days). Tokens are single-use rotated, so even if leaked, attacker has
# at most this long minus the time the legit user next refreshes.
JWT_REFRESH_TOKEN_TTL=604800

# OPTIONAL. JWT 'iss' claim. Stable identifier for this service across
# token issuance + verification. Don't change this in prod after launch
# (would invalidate all existing tokens).
JWT_ISSUER=3bayti-api

# =============================================================================
# OTP — MessageCentral CPaaS (M1.3)
# =============================================================================
#
# Production credentials from MessageCentral's CPaaS dashboard.
#
# In dev/test, the InMemoryOtpProvider is used automatically (no real
# SMS sends). To test against the real CPaaS from a dev machine, set
# SMS_PROVIDER=messagecentral and provide all three credentials below.

# OPTIONAL. Override OTP provider selection. Normally APP_ENV=prod
# implies MessageCentral; setting this lets a developer test against
# real CPaaS without changing APP_ENV.
# Values: messagecentral | (anything else falls back to env-based default)
SMS_PROVIDER=

# REQUIRED IF APP_ENV=prod OR SMS_PROVIDER=messagecentral.
# Account identifier from MessageCentral.
MESSAGECENTRAL_CUSTOMER_ID=

# REQUIRED IF APP_ENV=prod OR SMS_PROVIDER=messagecentral.
# Encoded API key. From MessageCentral dashboard.
MESSAGECENTRAL_KEY=

# REQUIRED IF APP_ENV=prod OR SMS_PROVIDER=messagecentral.
# Account email — used as the auth-token request identifier.
MESSAGECENTRAL_EMAIL=

# OPTIONAL. Country prefix for SMS-bound numbers. Default '971' (UAE).
# Note: not the ISO country code; this is MessageCentral's "country
# code" param (no leading +).
MESSAGECENTRAL_COUNTRY=971

# OPTIONAL. Override the CPaaS base URL — useful for staging / sandbox.
# Default is the production CPaaS URL.
MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com

# --- OTP abuse hardening (rate limits) ---------------------------------------
# Every send + verify path (otp-login, register/initiate, register email-OTP,
# send-otp resend, password reset, validate-phone) is throttled in OtpService.
# Each knob below is OPTIONAL; the listed value is the default applied when the
# var is unset. Setting a knob to 0 DISABLES that specific check.
#
# When a send/verify is throttled the API responds HTTP 429 with the body
#   { "error_code": "OTP_RATE_LIMITED", "retry_after": <seconds> }
# and a matching Retry-After header. Clients lock out Resend + Verify for
# retry_after seconds (falling back to ~60s if absent).
#
# Storage: counters live in Redis (REDIS_DSN). On a Redis error the
# per-destination caps fail CLOSED via a DB count of recent sends; the per-IP
# cap is skipped on Redis error (it's the generous outer guard).

# Minimum seconds between two dispatches to the SAME destination+purpose.
# Inside this window a resend RE-USES the latest still-valid code (true
# resend-dedup) instead of sending another SMS/email. Default 60.
OTP_RESEND_COOLDOWN_SECONDS=60

# Hard send caps. DISABLED by product decision — the only gate on OTP sends is
# the 60s resend cooldown above. 0 = no cap. Set any of these to a positive
# value ONLY if you need to throttle abuse; leave at 0 for "no hard limit".
# Per-destination rolling caps (phone for SMS, email for email channel).
OTP_SENDS_PER_HOUR=0
OTP_SENDS_PER_DAY=0
# Per-IP rolling caps. The real client IP is taken from Cloudflare's
# CF-Connecting-IP header when present, else the leftmost X-Forwarded-For
# entry, else REMOTE_ADDR.
OTP_SENDS_PER_IP_HOUR=0
OTP_SENDS_PER_IP_DAY=0

# Max failed verify attempts per code before the OTP row is burned (mirrors the
# email attempt-cap for SMS and adds a per-verification-id counter so a single
# code can't be sprayed). Default 5.
OTP_MAX_VERIFY_ATTEMPTS=5

# --- General transactional SMS (gift-card recipient delivery) ----------------
# Distinct from OTP: the OTP send endpoint generates its own code and
# cannot carry arbitrary text, so gift-card delivery needs a general SMS
# send. This is DISABLED BY DEFAULT — the app falls back to a no-op
# NullSmsSender so it always boots even with no SMS config. Email
# delivery is unaffected and still works on its own.
#
# To ENABLE real gift-card SMS delivery, set ALL of:
#   MESSAGECENTRAL_SMS_ENABLED=true
#   MESSAGECENTRAL_CUSTOMER_ID / MESSAGECENTRAL_KEY / MESSAGECENTRAL_EMAIL  (shared above)
#   MESSAGECENTRAL_SMS_SENDER_ID=<your approved sender/DLT id>
#   MESSAGECENTRAL_SMS_PATH=<the confirmed general-SMS send path>   (optional; default below)
#
# NOTE: MessageCentral's exact general-SMS send path + params are
# operator-confirmed per account. Confirm the path with MessageCentral
# and set MESSAGECENTRAL_SMS_PATH before flipping ENABLED to true.
MESSAGECENTRAL_SMS_ENABLED=false
MESSAGECENTRAL_SMS_SENDER_ID=
MESSAGECENTRAL_SMS_PATH=/verification/v3/send

# =============================================================================
# Email — ZeptoMail (M3+ for transactional emails)
# =============================================================================
#
# Not actually used in M1.4 (auth flows use SMS only). Kept here as a
# placeholder so the env-var inventory stays comprehensive. M3 adds
# email-based notifications (order shipped, password-changed alerts).

# REQUIRED IF email features enabled.
ZEPTOMAIL_API_TOKEN=

# Sender identity. Domain MUST have SPF + DKIM records configured per
# ZeptoMail's onboarding (otherwise emails go to spam).
ZEPTOMAIL_FROM_EMAIL=noreply@3bayti.ae
ZEPTOMAIL_FROM_NAME="3bayti"

# Comma-separated list of admin email addresses copied on critical
# events (disputes opened, etc.). Empty list disables admin
# notifications cleanly (dev/test default).
# Example: ADMIN_NOTIFICATION_EMAILS=ops@3bayti.ae,security@3bayti.ae
ADMIN_NOTIFICATION_EMAILS=

# Force a specific mail provider regardless of APP_ENV:
#   MAIL_PROVIDER=zeptomail  → ZeptoMailHttpMailer (requires the
#                              ZEPTOMAIL_* vars above to be set)
#   unset (default)          → APP_ENV=prod uses zeptomail, others
#                              use NullMailer (structured logs only)
# Useful for staging environments that need to send real emails
# without flipping APP_ENV to 'prod'.
MAIL_PROVIDER=

# =============================================================================
# Push notifications — Firebase Cloud Messaging (M3.2.Z.4)
# =============================================================================

# Push delivery uses FCM HTTP v1. FCM relays to APNs for iOS, so a
# single set of credentials covers both Android and iOS.
#
# The PushSenderInterface binding selects the implementation like the
# mailer does:
#   - APP_ENV=prod AND FCM credentials present → FcmHttpV1Sender
#   - PUSH_PROVIDER=fcm (explicit override)    → FcmHttpV1Sender
#   - otherwise                                → NullPushSender (logs only)
#
# Provide the Firebase service-account credentials in ANY ONE of these
# three ways (checked in this order):
#
#   1. The full service-account JSON inline (single line, escaped):
#        FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
#   2. A path to the service-account JSON file on disk:
#        FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
#   3. The three fields individually (private key may use literal \n):
#        FCM_PROJECT_ID=
#        FCM_CLIENT_EMAIL=
#        FCM_PRIVATE_KEY=
#
# Leave all unset in dev to use NullPushSender (would-send logging).
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# OPTIONAL. Force a push provider regardless of APP_ENV:
#   PUSH_PROVIDER=fcm  → FcmHttpV1Sender (requires FCM creds above)
# Unset → NullPushSender unless APP_ENV=prod with creds present.
PUSH_PROVIDER=

# =============================================================================
# Payments — Noon Payments (M3)
# =============================================================================

# Sandbox URL for dev/staging; replace with production URL for prod.
# Recon (M3.1.6 pre-phase): per docs.noonpayments.com, the canonical
# sandbox URL is `api-test.noonpayments.com`. The legacy default of
# `api-test.sandbox.noonpayments.com` may also work but isn't the
# documented one — verify at deploy time.
NOON_API_BASE=https://api-test.noonpayments.com

# REQUIRED IF checkout features enabled (M3.1.6+).
#
# Auth header format (from docs.noonpayments.com/sdk/reference/ios):
#   Authorization: Key <base64({businessIdentifier}.{appIdentifier}:{appKey})>
#
# Three identifiers are required, NOT two:
#   - NOON_BUSINESS_IDENTIFIER — merchant account identifier
#   - NOON_APP_IDENTIFIER      — application identifier within the merchant
#   - NOON_APP_KEY             — the secret key (was misnamed NOON_API_KEY)
#
# NOON_API_KEY is retained as a deprecated alias for back-compat; the
# adapter checks NOON_APP_KEY first, falls back to NOON_API_KEY with
# a deprecation log line.
NOON_BUSINESS_IDENTIFIER=
NOON_APP_IDENTIFIER=
NOON_APP_KEY=
NOON_API_KEY=
# REQUIRED. The order route category for INITIATE — must match a category
# pre-configured on your noon account (listed in your onboarding email).
# An unconfigured/blank value is rejected with resultCode 19004.
NOON_ORDER_CATEGORY=
# OPTIONAL. Test | Live — selects the Authorization scheme (Key_Test /
# Key_Live). If unset, it's derived from NOON_API_BASE (api-test* => Test,
# otherwise Live). Set explicitly only if your host/mode ever diverge.
NOON_MODE=

# Webhook signature secret. Algorithm not yet confirmed (Noon webhook
# docs gated behind merchant portal); M3.1.6 ships with logging-only
# verifier and the retrieve-order-before-acting safety net. M3.1.7-A
# adds NOON_VERIFY_SIGNATURE flag (below) to enable strict checking
# once operator has captured + confirmed the algorithm empirically.
NOON_WEBHOOK_SECRET=

# Webhook signature verification toggle (M3.1.7-A).
#
# 'true'  → strict HMAC-SHA256 verification (requires NOON_WEBHOOK_SECRET
#           to be set; container build fails fast if missing). Spoofed
#           webhooks are rejected with 401 before any retrieve-order call.
# 'false' (default) → LoggingOnlyVerifier; accepts all webhooks and logs
#           sha256(body) + signature header for forensic capture.
#           Safety net is retrieve-order-before-acting in the controller —
#           even unsigned webhooks cannot mark an order paid because v3
#           asks Noon's GET_ORDER directly for the authoritative state.
#
# Roll-out plan:
#   1. Deploy with =false, and set NOON_WEBHOOK_CAPTURE=true (below) for a
#      short window so real (body+signature) pairs are recorded verbatim.
#   2. Run `php bin/console noon:confirm-signature` — it brute-forces the
#      candidate schemes against the captured pairs and reports which one
#      Noon uses. Then set NOON_WEBHOOK_CAPTURE back to false.
#   3. If it confirms hmac-sha256-hex, flip =true. If a different algorithm,
#      swap the verifier class in config/di.php; interface contract is
#      unchanged.
NOON_VERIFY_SIGNATURE=false

# Webhook raw-capture toggle (M3.1.7) — rollout aid ONLY.
#
# 'true' / '1' → NoonWebhookCaptureRecorder writes each incoming webhook's
#                raw body + raw signature header (NEVER the secret) as JSON
#                lines to var/captures/noon-webhook-YYYY-MM-DD.jsonl, so
#                `noon:confirm-signature` can confirm the signing algorithm
#                from real traffic (the DB stores only re-parsed JSON, and
#                LoggingOnlyVerifier logs only hashes — neither can confirm
#                an HMAC).
# 'false' (default) → no capture.
#
# Leave OFF in steady state. Enable for a short window during the
# NOON_VERIFY_SIGNATURE rollout, then switch back off.
NOON_WEBHOOK_CAPTURE=false

# =============================================================================
# Object storage — Cloudflare R2 (M2 for product images; M3.2.X.18-B for return photos)
# =============================================================================
#
# v3 storage path
# ---------------
# v1 (M3.2.X.18-B current): the FilesystemOperator DI binding in
# config/di.php uses LocalFilesystemAdapter rooted at
# apps/api/var/uploads/. Return photos land at:
#   var/uploads/return-photos/{YYYY}/{MM}/{return-request-id}/{ulid}.{ext}
#
# Future R2/S3 migration is a single-binding swap in config/di.php
# — consumer code uses FilesystemOperator surface and is storage-
# agnostic. When ready, replace LocalFilesystemAdapter with
# AwsS3V3Adapter pointed at R2 (S3-compatible).

# REQUIRED IF media features enabled (M2+).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name + public CDN URL.
R2_BUCKET=3bayti-uploads
R2_PUBLIC_URL=https://cdn.3bayti.ae

# =============================================================================
# Shipping — Topex (M3)
# =============================================================================

TOPEX_API_BASE=https://shipperapi.topex.ae
# REQUIRED IF shipping features enabled.
TOPEX_API_KEY=

# =============================================================================
# Observability
# =============================================================================

# OPTIONAL. Sentry DSN for error tracking. Without it, errors are
# logged to stderr only (still captured by App Platform).
SENTRY_DSN=

# OPTIONAL. Log level. 'debug' for dev (verbose); 'info' for staging;
# 'warning' for production (less noise, easier to spot real issues).
# Values: debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug

# =============================================================================
# CORS — allowed origins for browser requests
# =============================================================================
#
# Comma-separated list. Origins not matching get refused at the CORS
# layer (added in M1.6+). Local dev uses localhost; production lists
# the real customer + vendor surfaces.

CORS_ALLOWED_ORIGINS=http://localhost:4200,https://staging.3bayti.ae,https://3bayti.ae,https://vendor.3bayti.ae

# =============================================================================
# Container runtime (entrypoint.sh, only relevant inside Docker)
# =============================================================================

# OPTIONAL. Set by App Platform automatically. Local docker run can
# override: '-e PORT=8080'.
PORT=8080

# OPTIONAL. Toggle the entrypoint's "wait for DB" loop on startup.
# 1 = wait up to 30s for DB_HOST:DB_PORT to be reachable before
# starting nginx + php-fpm. 0 = skip (start immediately, useful when
# DB is on the same host or known to be up).
WAIT_FOR_DB=1
