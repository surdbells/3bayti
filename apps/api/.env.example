# 3bayti API — environment configuration template.
#
# Copy this file to .env in the same directory and fill in real values.
# DO NOT commit .env. Production values live in DigitalOcean App Platform's
# encrypted secret store; this file documents what's needed.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=dev                        # 'dev', 'test', 'prod'
APP_DEBUG=true
APP_VERSION=dev
APP_URL=http://localhost:8080

# A 32-byte random string. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# -----------------------------------------------------------------------------
# Database — PostgreSQL 16
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=3bayti
DB_USERNAME=3bayti
DB_PASSWORD=
DB_DRIVER=pdo_pgsql
DB_CHARSET=utf8

# -----------------------------------------------------------------------------
# Redis (cache, sessions, queue transport)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT (auth tokens)
# -----------------------------------------------------------------------------
# 64+ byte random secret. Used to sign HS256 JWTs.
# Generate with: php -r "echo bin2hex(random_bytes(64));"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=900           # seconds — 15 minutes
JWT_REFRESH_TOKEN_TTL=604800       # seconds — 7 days

# -----------------------------------------------------------------------------
# Email — ZeptoMail
# -----------------------------------------------------------------------------
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@3bayti.ae
ZEPTOMAIL_FROM_NAME="3bayti"

# -----------------------------------------------------------------------------
# SMS — MessageCentral CPaaS
# -----------------------------------------------------------------------------
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_KEY=
MESSAGECENTRAL_EMAIL=

# -----------------------------------------------------------------------------
# Payments — Noon Payments
# -----------------------------------------------------------------------------
NOON_API_BASE=https://api-test.sandbox.noonpayments.com   # 'sandbox' or production URL
NOON_API_KEY=
NOON_BUSINESS_IDENTIFIER=

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=3bayti-uploads
R2_PUBLIC_URL=https://cdn.3bayti.ae

# -----------------------------------------------------------------------------
# Shipping — Topex
# -----------------------------------------------------------------------------
TOPEX_API_BASE=https://shipperapi.topex.ae
TOPEX_API_KEY=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug                    # 'debug', 'info', 'warning', 'error'

# -----------------------------------------------------------------------------
# CORS (allowed origins, comma-separated)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://staging.3bayti.ae,https://3bayti.ae,https://vendor.3bayti.ae
