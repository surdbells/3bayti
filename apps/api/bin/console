#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * 3bayti API — Doctrine CLI entry point.
 *
 * Provides:
 *   - doctrine:* commands (schema, query, etc.) — bin/console doctrine:list
 *   - migrations:* commands — bin/console migrations:diff, migrations:migrate, etc.
 *
 * Uses the same Bootstrap factory as the HTTP entry point, so CLI
 * and web share configuration. Reads .env via Bootstrap.
 *
 * Usage examples:
 *   php bin/console migrations:status
 *   php bin/console migrations:diff
 *   php bin/console migrations:migrate
 *   php bin/console doctrine:schema:validate
 */

use Bayti\Api\Bootstrap;
use Bayti\Api\Console\DispatchScheduledGiftCardsCommand;
use Bayti\Api\Console\ReconcilePendingOrdersCommand;
use Bayti\Api\Console\SendAbandonedCartRemindersCommand;
use Bayti\Api\Console\SendDeliveryFollowupsCommand;
use Bayti\Api\Console\SendReengagementNudgesCommand;
use Bayti\Api\Domain\Cart\CartAbandonmentFinder;
use Bayti\Api\Notification\CartNotificationService;
use Bayti\Api\Notification\Push\PushNotificationLogger;
use Bayti\Api\Notification\Push\PushNotificationService;
use Bayti\Api\Payment\PaymentGatewayInterface;
use Doctrine\DBAL\Tools\Console\ConsoleRunner as DbalConsoleRunner;
use Doctrine\DBAL\Tools\Console\Command\RunSqlCommand;
use Doctrine\Migrations\Configuration\Migration\PhpFile;
use Doctrine\Migrations\Configuration\Connection\ExistingConnection;
use Doctrine\Migrations\DependencyFactory;
use Doctrine\Migrations\Tools\Console\Command;
use Doctrine\ORM\EntityManagerInterface;
use Doctrine\ORM\Tools\Console\ConsoleRunner;
use Doctrine\ORM\Tools\Console\EntityManagerProvider\SingleManagerProvider;
use Psr\Log\LoggerInterface;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

// Build the Slim app to get a fully-wired DI container, then pull
// the EntityManager out of it. The .env loading and config wiring
// happen here in one go.
$app = Bootstrap::createApp();
$container = $app->getContainer();
if ($container === null) {
    fwrite(STDERR, "DI container missing — Bootstrap.php should always provide one.\n");
    exit(1);
}

/** @var EntityManagerInterface $em */
$em = $container->get(EntityManagerInterface::class);

// Build a Symfony Console application and register Doctrine commands.
$cli = new Application('3bayti API CLI', '0.1.0');

// Doctrine ORM commands (schema validate, info, etc.)
ConsoleRunner::addCommands($cli, new SingleManagerProvider($em));

// Doctrine DBAL commands (run-sql)
$cli->add(new RunSqlCommand(new \Doctrine\DBAL\Tools\Console\ConnectionProvider\SingleConnectionProvider($em->getConnection())));

// Doctrine Migrations commands. Configured via the file at the
// project root. We do not use migrations.php auto-discovery; we
// declare paths explicitly.
$migrationsConfig = new PhpFile(__DIR__ . '/../migrations.php');
$migrationsFactory = DependencyFactory::fromConnection(
    $migrationsConfig,
    new ExistingConnection($em->getConnection()),
);

$cli->addCommands([
    new Command\DumpSchemaCommand($migrationsFactory),
    new Command\ExecuteCommand($migrationsFactory),
    new Command\GenerateCommand($migrationsFactory),
    new Command\LatestCommand($migrationsFactory),
    new Command\ListCommand($migrationsFactory),
    new Command\MigrateCommand($migrationsFactory),
    new Command\DiffCommand($migrationsFactory),
    new Command\StatusCommand($migrationsFactory),
    new Command\VersionCommand($migrationsFactory),
    new Command\UpToDateCommand($migrationsFactory),
    new Command\SyncMetadataCommand($migrationsFactory),
    new Command\RollupCommand($migrationsFactory),
]);

// M3.1.7-B — Application commands. Pull collaborators from the
// container at registration time. The PaymentGateway resolution
// requires NOON_* env vars; if those are missing (fresh dev
// sandbox, CI migration runs, etc.) we still want `bin/console
// list`, `migrations:*`, and `doctrine:*` to work. So we attempt
// eager resolution and skip registering the reconciliation
// command if the gateway can't be built. Operators running the
// reconciliation cron on production will have the env vars set;
// developers running migrations locally don't need this command.
/** @var LoggerInterface $logger */
$logger = $container->get(LoggerInterface::class);

try {
    /** @var PaymentGatewayInterface $gateway */
    $gateway = $container->get(PaymentGatewayInterface::class);
    // ReconcilePendingOrdersCommand also needs the flash-campaign stock
    // reducer (4th ctor arg). Resolve it from the container so this
    // registration can't drift out of sync with the command signature.
    $flashStock = $container->get(\Bayti\Api\Domain\Catalog\FlashCampaignStockReducer::class);
    $cli->add(new ReconcilePendingOrdersCommand($em, $gateway, $logger, $flashStock));
} catch (\Throwable $e) {
    // Log the reason — visible if anyone runs `bin/console
    // orders:reconcile-pending` and gets a "command not found"
    // error. Easier diagnosis than silent omission.
    $logger->info('reconcile command not registered: payment gateway unavailable', [
        'reason' => $e->getMessage(),
    ]);
}

// M3.2.X.11-F — Cart abandonment reminders. Eagerly resolves
// the finder + notification service via DI. Independent of the
// payment gateway availability above so a fresh dev sandbox
// without NOON_* env vars can still run this command.
try {
    /** @var CartAbandonmentFinder $finder */
    $finder = $container->get(CartAbandonmentFinder::class);
    /** @var CartNotificationService $cartNotifications */
    $cartNotifications = $container->get(CartNotificationService::class);
    /** @var PushNotificationService $pushService */
    $pushService = $container->get(PushNotificationService::class);
    /** @var PushNotificationLogger $pushLog */
    $pushLog = $container->get(PushNotificationLogger::class);
    $cli->add(new SendAbandonedCartRemindersCommand(
        $em,
        $finder,
        $cartNotifications,
        $logger,
        $pushService,
        $pushLog,
    ));
} catch (\Throwable $e) {
    $logger->info('cart reminders command not registered', [
        'reason' => $e->getMessage(),
    ]);
}

// Marketing-push scheduled jobs — post-delivery review prompt +
// re-engagement nudge. Both resolve the push service + push log ledger
// from the container; independent of payment-gateway availability so a
// fresh sandbox can still run them.
try {
    /** @var PushNotificationService $pushService */
    $pushService = $container->get(PushNotificationService::class);
    /** @var PushNotificationLogger $pushLog */
    $pushLog = $container->get(PushNotificationLogger::class);
    $cli->add(new SendDeliveryFollowupsCommand($em, $pushService, $pushLog, $logger));
    $cli->add(new SendReengagementNudgesCommand($em, $pushService, $pushLog, $logger));
} catch (\Throwable $e) {
    $logger->info('marketing-push commands not registered', [
        'reason' => $e->getMessage(),
    ]);
}

// Gift-card scheduled/retry delivery. Resolves the delivery service
// via DI (which env-gates the SMS sender, defaulting to a no-op). No
// payment-gateway dependency, so it registers on a fresh sandbox too.
try {
    /** @var \Bayti\Api\Notification\GiftCardDeliveryService $giftDelivery */
    $giftDelivery = $container->get(\Bayti\Api\Notification\GiftCardDeliveryService::class);
    $cli->add(new DispatchScheduledGiftCardsCommand($em, $giftDelivery, $logger));
} catch (\Throwable $e) {
    $logger->info('gift-card dispatch command not registered', [
        'reason' => $e->getMessage(),
    ]);
}

// M3.1.7 — offline Noon webhook signature-algorithm confirmation.
// Reads captured pairs from var/captures; no DB/network deps, so it
// registers unconditionally (handy even on a fresh sandbox).
$cli->add(new \Bayti\Api\Console\ConfirmNoonSignatureCommand(
    captureDir: dirname(__DIR__) . '/var/captures',
    defaultSecret: isset($_ENV['NOON_WEBHOOK_SECRET']) && $_ENV['NOON_WEBHOOK_SECRET'] !== ''
        ? (string) $_ENV['NOON_WEBHOOK_SECRET']
        : null,
));

$cli->run();
