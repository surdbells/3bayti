# Hashed bundles — safe to cache forever (filename changes on every build)
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Never cache the shell — new deploys must be seen instantly
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# i18n JSON — must always revalidate so new translation keys are never served stale
# (must come BEFORE the broad /assets/* rule — Cloudflare Pages uses first-match)
/assets/i18n/*
  Cache-Control: no-cache, must-revalidate

# Images and fonts — cache aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable
