# fastlane screengrab — https://docs.fastlane.tools/actions/screengrab/
#
# Captures Play Store phone screenshots from the REAL app running on an
# emulator/device. Portrait phone shots (e.g. 1080 x 2400) satisfy Play's
# requirement (2-8 images, aspect ratio <= 2:1). Tablet shots are optional and
# omitted (the app is phone-first).
app_package_name("ae.threebayti.app")

# APKs produced by the `screenshots` lane (assembleDebug + assembleDebugAndroidTest).
app_apk_path("app/build/outputs/apk/debug/app-debug.apk")
tests_apk_path("app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk")

use_tests_in_classes(["ae.threebayti.app.ScreenshotTest"])
test_instrumentation_runner("androidx.test.runner.AndroidJUnitRunner")

# Drop "ar" if you are not publishing Arabic screenshots.
locales(["en-US", "ar"])

clear_previous_screenshots(true)
# Output: android/fastlane/metadata/android/<locale>/images/phoneScreenshots/
