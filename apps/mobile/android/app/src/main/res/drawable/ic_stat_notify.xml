<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome notification small-icon (status bar). Android masks the small
  icon to a flat white silhouette via its ALPHA channel, so this MUST be a
  single solid shape on a transparent background — a full-colour launcher
  icon (the previous fallback) renders as a blank white square, which is the
  bug this fixes. Wired in AndroidManifest.xml via
  com.google.firebase.messaging.default_notification_icon.
-->
