require_relative '../../../../node_modules/.pnpm/@capacitor+ios@8.3.3_@capacitor+core@8.3.3/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../node_modules/.pnpm/@capacitor+ios@8.3.3_@capacitor+core@8.3.3/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../node_modules/.pnpm/@capacitor+ios@8.3.3_@capacitor+core@8.3.3/node_modules/@capacitor/ios'
  pod 'CapacitorFirebaseAuthentication', :path => '../../../../node_modules/.pnpm/@capacitor-firebase+authentication@8.3.0_@capacitor+core@8.3.3_firebase@12.15.0/node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorApp', :path => '../../../../node_modules/.pnpm/@capacitor+app@8.1.0_@capacitor+core@8.3.3/node_modules/@capacitor/app'
  pod 'CapacitorClipboard', :path => '../../../../node_modules/.pnpm/@capacitor+clipboard@8.0.1_@capacitor+core@8.3.3/node_modules/@capacitor/clipboard'
  pod 'CapacitorHaptics', :path => '../../../../node_modules/.pnpm/@capacitor+haptics@8.0.2_@capacitor+core@8.3.3/node_modules/@capacitor/haptics'
  pod 'CapacitorNetwork', :path => '../../../../node_modules/.pnpm/@capacitor+network@8.0.1_@capacitor+core@8.3.3/node_modules/@capacitor/network'
  pod 'CapacitorPreferences', :path => '../../../../node_modules/.pnpm/@capacitor+preferences@8.0.1_@capacitor+core@8.3.3/node_modules/@capacitor/preferences'
  pod 'CapacitorPushNotifications', :path => '../../../../node_modules/.pnpm/@capacitor+push-notifications@8.0.4_@capacitor+core@8.3.3/node_modules/@capacitor/push-notifications'
  pod 'CapacitorScreenOrientation', :path => '../../../../node_modules/.pnpm/@capacitor+screen-orientation@8.0.1_@capacitor+core@8.3.3/node_modules/@capacitor/screen-orientation'
  pod 'CapacitorSplashScreen', :path => '../../../../node_modules/.pnpm/@capacitor+splash-screen@8.0.1_@capacitor+core@8.3.3/node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../../../node_modules/.pnpm/@capacitor+status-bar@8.0.2_@capacitor+core@8.3.3/node_modules/@capacitor/status-bar'
  pod 'CapawesomeCapacitorAppUpdate', :path => '../../../../node_modules/.pnpm/@capawesome+capacitor-app-update@8.0.3_@capacitor+core@8.3.3/node_modules/@capawesome/capacitor-app-update'
  pod 'CapgoCapacitorContacts', :path => '../../../../node_modules/.pnpm/@capgo+capacitor-contacts@8.0.17_@capacitor+core@8.3.3/node_modules/@capgo/capacitor-contacts'
  pod 'CapgoCapacitorUpdater', :path => '../../../../node_modules/.pnpm/@capgo+capacitor-updater@8.51.3_@capacitor+core@8.3.3/node_modules/@capgo/capacitor-updater'
  pod 'CapgoInappbrowser', :path => '../../../../node_modules/.pnpm/@capgo+inappbrowser@8.0.6_patch_hash=u2mrdjiw46mrceqn4foagmkmce_@capacitor+core@8.3.3/node_modules/@capgo/inappbrowser'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # FCM push. Pinned to the Firebase 12.x line so it shares FirebaseCore with
  # @capacitor-firebase/authentication (FirebaseAuth ~> 12.7). Leaving it
  # unversioned let the lock hold it at 11.15, which clashed with the auth
  # plugin's FirebaseCore 12.7 (CocoaPods can't have two FirebaseCore majors).
  pod 'FirebaseMessaging', '~> 12.7'
  # Native Google Sign-In. @capacitor-firebase/authentication defaults to its
  # 'Lite' subspec (FirebaseAuth only, NO GoogleSignIn SDK), so on iOS
  # signInWithGoogle() has no native SDK/handler and hangs at "Signing in…".
  # Pulling the 'Google' subspec adds GoogleSignIn 9.0.0 + the
  # -DRGCFA_INCLUDE_GOOGLE flag that compiles in the plugin's Google path.
  # It lives here in the target block (not the auto-generated capacitor_pods
  # def), so `npx cap sync` won't drop it. Run `pod install` after adding.
  pod 'CapacitorFirebaseAuthentication/Google', :path => '../../../../node_modules/.pnpm/@capacitor-firebase+authentication@8.3.0_@capacitor+core@8.3.3_firebase@12.15.0/node_modules/@capacitor-firebase/authentication'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
