# Auto-detect text files and normalise to LF on commit
* text=auto eol=lf

# Explicit text types
*.md text
*.json text
*.yml text
*.yaml text
*.ts text
*.js text
*.scss text
*.css text
*.html text
*.php text
*.sql text
*.sh text eol=lf

# Explicit binary types (don't try to diff/normalise)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
