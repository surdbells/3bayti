# pnpm configuration
# Reference: https://pnpm.io/npmrc

# Use the standard pnpm node_modules layout (isolated; per-package node_modules
# linked from a content-addressable store at the workspace root). This is what
# makes pnpm fast and disk-efficient.
node-linker=isolated

# Allow workspace dependencies to use the `workspace:` protocol.
# `workspace:*` matches the local version regardless of what's published.
prefer-workspace-packages=true

# Don't auto-install peerDependencies for packages that don't already declare
# them. Angular has a complex peer graph; this avoids surprising auto-installs.
auto-install-peers=true

# Lockfile resolution: be strict.
strict-peer-dependencies=false

# Save dependencies with exact versions (no ^/~). Less drift in CI.
save-exact=true

# Always use the lockfile in CI/builds.
frozen-lockfile=false

# Unsafe-perm: needed for some native modules during install (sharp, esbuild).
unsafe-perm=true
