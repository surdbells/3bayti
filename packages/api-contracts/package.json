{
  "name": "@3bayti/api-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI spec + generated TypeScript types for the 3bayti API. Single source of truth across web/mobile/portal.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./openapi": "./openapi.yaml"
  },
  "files": [
    "src",
    "openapi.yaml"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "echo 'lint not configured (M0.4)'",
    "codegen": "openapi-typescript openapi.yaml -o src/generated.ts"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@3bayti/tsconfig": "workspace:*",
    "openapi-typescript": "7.4.4",
    "typescript": "5.9.2"
  }
}
